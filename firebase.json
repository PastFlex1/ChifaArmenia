{
  "firestore": {
    "rules": "firestore.rules",
    "database": "(default)"
  },
  "apphosting": [
    {
      "backendId": "chifa-app",
      "rootDir": "/",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "functions",
        "node.exe",
        "*.exe",
        "dist",
        ".agents"
      ],
      "alwaysDeployFromSource": true
    }
  ]
}
